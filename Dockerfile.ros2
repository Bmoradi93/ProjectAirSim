# ---------------------------------------------------------------------------------------------------------------------
#
# Dockerfile.ros2 - ROS 2 Humble container for Project AirSim + MAVROS + Autonomy Stack.
#
# Includes:
#   - ROS 2 Humble (Ubuntu 22.04) + RViz2 + rqt_image_view
#   - GeographicLib datasets and all dependencies required to build MAVROS (`ros2_workspace/src/mavros`)
#   - Project AirSim repo bind-mounted at /workspace/ProjectAirSim (via docker-compose.yml) so
#     `ros/` (`projectairsim_ros2_cpp`) and `ros2_workspace/` (`mavros` + autonomy packages) build and run in-place.
#
# ---------------------------------------------------------------------------------------------------------------------

FROM ros:humble-ros-base

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=dev

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    ROS_DISTRO=humble

# Install build tools, GeographicLib, and ROS 2 build dependencies for MAVROS & Project AirSim ROS 2 bridge
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        geographiclib-tools \
        git \
        libasio-dev \
        libboost-dev \
        libconsole-bridge-dev \
        libeigen3-dev \
        libgeographic-dev \
        ninja-build \
        pkg-config \
        python3-click \
        python3-colcon-common-extensions \
        python3-pip \
        python3-rosdep \
        python3-vcstool \
        ros-humble-angles \
        ros-humble-control-msgs \
        ros-humble-diagnostic-msgs \
        ros-humble-diagnostic-updater \
        ros-humble-eigen-stl-containers \
        ros-humble-eigen3-cmake-module \
        ros-humble-geographic-msgs \
        ros-humble-geometry-msgs \
        ros-humble-mavlink \
        ros-humble-message-filters \
        ros-humble-nav-msgs \
        ros-humble-pluginlib \
        ros-humble-rclcpp \
        ros-humble-rclcpp-action \
        ros-humble-rclcpp-components \
        ros-humble-rcpputils \
        ros-humble-rosgraph-msgs \
        ros-humble-rosidl-default-generators \
        ros-humble-rosidl-default-runtime \
        ros-humble-rqt-image-view \
        ros-humble-rviz2 \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
        ros-humble-std-srvs \
        ros-humble-tf2-eigen \
        ros-humble-tf2-msgs \
        ros-humble-tf2-ros \
        ros-humble-trajectory-msgs \
        ros-humble-urdf \
        ros-humble-visualization-msgs \
        sudo \
        wget \
    && rm -rf /var/lib/apt/lists/* || true

# Non-root user matching host UID/GID
RUN (getent group ${GROUP_ID} || groupadd -g ${GROUP_ID} ${USERNAME}) \
    && (getent passwd ${USER_ID} || useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash ${USERNAME}) \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Install GeographicLib datasets required by MAVROS (egm96-5 geoid, egm96 gravity, emm2015 magnetic)
RUN geographiclib-get-geoids egm96-5 \
    && geographiclib-get-gravity egm96 \
    && geographiclib-get-magnetic emm2015

# Auto-source ROS 2 Humble and ros2_workspace (if built)
RUN sed -i '/exec "\$@"/i if [ -f "/workspace/ProjectAirSim/ros2_workspace/install/setup.bash" ]; then source "/workspace/ProjectAirSim/ros2_workspace/install/setup.bash"; fi' /ros_entrypoint.sh \
    && echo 'source /opt/ros/humble/setup.bash' >> /home/${USERNAME}/.bashrc \
    && echo 'if [ -f "/workspace/ProjectAirSim/ros2_workspace/install/setup.bash" ]; then source "/workspace/ProjectAirSim/ros2_workspace/install/setup.bash"; fi' >> /home/${USERNAME}/.bashrc

USER ${USERNAME}
ENV HOME=/home/${USERNAME}
WORKDIR /workspace/ProjectAirSim

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]
