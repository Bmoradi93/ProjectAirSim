<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>efferax_launcher</name>
  <version>0.1.0</version>
  <description>Master bringup launch package for the Efferax PX4 + MAVROS + Project AirSim autonomy stack.</description>
  <maintainer email="dev@projectairsim.local">ProjectAirSim Dev</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>projectairsim_ros2_cpp</exec_depend>
  <exec_depend>px4_joy_teleop</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
