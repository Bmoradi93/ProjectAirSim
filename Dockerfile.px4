# ---------------------------------------------------------------------------------------------------------------------
#
# Dockerfile.px4 - Container image for building & running PX4 Autopilot v1.12.3 SITL with Project AirSim.
#
# Uses Ubuntu 20.04 (PX4 v1.12.3's official target OS in Tools/setup/ubuntu.sh) and installs the
# PX4 SITL build/runtime toolchain without Gazebo/jMAVSim or NuttX hardware cross-compilers.
# The PX4-Autopilot source tree is bind-mounted at /workspace/PX4-Autopilot via docker-compose.yml.
#
# ---------------------------------------------------------------------------------------------------------------------

FROM ubuntu:20.04

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=dev

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        astyle \
        bc \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        cppcheck \
        curl \
        file \
        g++ \
        gcc \
        gdb \
        git \
        gnupg \
        lcov \
        libeigen3-dev \
        libxml2-utils \
        lsb-release \
        make \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        rsync \
        shellcheck \
        sudo \
        unzip \
        wget \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching host UID/GID so bind-mounted PX4 build artifacts remain owned by the host user
RUN (getent group ${GROUP_ID} || groupadd -g ${GROUP_ID} ${USERNAME}) \
    && (getent passwd ${USER_ID} || useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash ${USERNAME}) \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Install PX4 v1.12.3 Python dependencies (pinned empy==3.3.4 for compatibility with PX4 v1.12 templates)
RUN python3 -m pip install --no-cache-dir --upgrade "pip<24.1" "setuptools<60" wheel \
    && python3 -m pip install --no-cache-dir \
        argcomplete \
        "argparse>=1.2" \
        cerberus \
        coverage \
        "empy==3.3.4" \
        "jinja2>=2.8,<3.1" \
        "markupsafe<2.1" \
        "numpy>=1.13,<1.24" \
        "nunavut>=1.1.0" \
        packaging \
        "pandas>=0.21" \
        pkgconfig \
        psutil \
        pygments \
        pymavlink \
        pyros-genmsg \
        pyserial \
        "pyulog>=0.5.0" \
        pyyaml \
        requests \
        "six>=1.12.0" \
        "toml>=0.9"

USER ${USERNAME}
ENV HOME=/home/${USERNAME}
WORKDIR /workspace/PX4-Autopilot

CMD ["make", "px4_sitl", "none_iris"]
